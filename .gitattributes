# Normalise text to LF in the repository, whatever the checkout does locally —
# this project is developed on Windows and deployed on Linux.
#
# Order matters: later rules override earlier ones, so this catch-all has to
# come first. With it last it silently re-marked the PDF as text, and a fresh
# clone produced a file with a broken xref table.
* text=auto

# Binary, and Git must not touch the line endings.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.xlsx  binary
