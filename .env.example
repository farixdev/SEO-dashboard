# ─────────────────────────────────────────────────────────────
# Neon Postgres
# Create a project at https://console.neon.tech, then copy the
# "Pooled connection" string from Dashboard → Connect.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Auth — signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="change-me-to-a-long-random-string"
SESSION_MAX_AGE_DAYS="14"

# ─────────────────────────────────────────────────────────────
# Seed credentials — the first admin created by `npm run db:seed`
# ─────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@mindcob.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="SEO Admin"

# Public app URL (used for invite links shown in the UI)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for POST /api/cron/<job> (sweep-invites, prune-activity).
# Unset means every scheduled job refuses to run. 16+ characters.
CRON_SECRET=""
